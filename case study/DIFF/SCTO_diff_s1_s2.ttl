@prefix memento: <http://www.dmi.unict.memento/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/memento/state/SCTO/s2> a memento:OntologyState ;
    memento:hasOntologyStateVersion <http://example.org/memento/version/SCTO/s2-version-2.0.0-remove-one> ;
    memento:hasPreviousState <http://example.org/memento/state/SCTO/s1> ;
    prov:startedAtTime "2026-04-12T16:43:18+00:00"^^xsd:dateTime ;
    prov:wasGeneratedBy <http://example.org/memento/agent/Shaker_El-Sappagh> .

<http://example.org/memento/version/SCTO/s2-version-2.0.0-remove-one> a memento:OntologyStateVersion ;
    memento:hasOntologyStateVersionLabel "2.0.0-remove-one"^^xsd:string ;
    memento:hasOntologyStateVersionMajorRevision 2 ;
    memento:hasOntologyStateVersionMetadata "remove-one"^^xsd:string ;
    memento:hasOntologyStateVersionMinorRevision 0 ;
    memento:hasOntologyStateVersionPatchRevision 0 .

<http://example.org/memento/agent/Shaker_El-Sappagh> a prov:Agent,
        prov:Person .

<http://purl.obolibrary.org/obo/ogms.owl#SCTO_362981000> rdfs:label "qualifier value" .

<https://bioportal.bioontology.org/ontologies/SCTO#SCTO_7389001> a owl:Class ;
    rdfs:label "time frame"@en ;
    memento:hasOntologyStateChange <http://example.org/memento/change/SCTO/SCTO-2026-04-12T16:43:18Z-s2-0001> ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/ogms.owl#SCTO_362981000> .

<http://example.org/memento/change/SCTO/SCTO-2026-04-12T16:43:18Z-s2-0001> a memento:DelChangeAction,
        memento:OntologyStateChange,
        <http://www.list.lu/change-ontology/BasicChange>,
        <http://www.list.lu/change-ontology/delC>,
        prov:Entity ;
    memento:hasOntologyState <http://example.org/memento/state/SCTO/s2> ;
    prov:startedAtTime "2026-04-12T16:43:18+00:00"^^xsd:dateTime ;
    prov:wasGeneratedBy <http://example.org/memento/agent/Shaker_El-Sappagh> .

[] a owl:Axiom ;
    memento:hasOntologyStateChange <http://example.org/memento/change/SCTO/SCTO-2026-04-12T16:43:18Z-s2-0001> ;
    owl:annotatedProperty rdf:type ;
    owl:annotatedSource <https://bioportal.bioontology.org/ontologies/SCTO#SCTO_7389001> ;
    owl:annotatedTarget owl:Class .

[] a owl:Axiom ;
    memento:hasOntologyStateChange <http://example.org/memento/change/SCTO/SCTO-2026-04-12T16:43:18Z-s2-0001> ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource <https://bioportal.bioontology.org/ontologies/SCTO#SCTO_7389001> ;
    owl:annotatedTarget <http://purl.obolibrary.org/obo/ogms.owl#SCTO_362981000> .

