<http://example.org/memento/axiom/SCTO/42d96107b34542ba94e9c089e6a01ccb> a owl:Axiom ;
    memento:hasOntologyStateChange <http://example.org/memento/change/SCTO/SCTO-2026-03-30T15:06:30Z-s1-0001>,
        <http://example.org/memento/change/SCTO/SCTO-2026-03-30T15:06:31Z-s2-0001>,
        <http://example.org/memento/change/SCTO/SCTO-2026-03-30T15:06:32Z-s3-0001> ;
    owl:annotatedProperty rdf:type ;
    owl:annotatedSource <https://bioportal.bioontology.org/ontologies/SCTO#SCTO_7389001> ;
    owl:annotatedTarget owl:Class .

<http://example.org/memento/axiom/SCTO/a1aedc0352f14d35b6ce27a15b39a381> a owl:Axiom ;
    memento:hasOntologyStateChange <http://example.org/memento/change/SCTO/SCTO-2026-03-30T15:06:30Z-s1-0001>,
        <http://example.org/memento/change/SCTO/SCTO-2026-03-30T15:06:31Z-s2-0001>,
        <http://example.org/memento/change/SCTO/SCTO-2026-03-30T15:06:32Z-s3-0001> ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource <https://bioportal.bioontology.org/ontologies/SCTO#SCTO_7389001> ;
    owl:annotatedTarget <http://purl.obolibrary.org/obo/ogms.owl#SCTO_362981000> .

<http://purl.obolibrary.org/obo/ogms.owl#SCTO_362981000> a owl:Class ;
    rdfs:label "qualifier value" .

<https://bioportal.bioontology.org/ontologies/SCTO#SCTO_7389001> a owl:Class ;
    rdfs:label "time frame"@en ;
    memento:hasOntologyStateChange <http://example.org/memento/change/SCTO/SCTO-2026-03-30T15:06:31Z-s2-0001> ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/ogms.owl#SCTO_362981000> .

<http://example.org/memento/change/SCTO/SCTO-2026-03-30T15:06:31Z-s2-0001> a memento:DelChangeAction,
